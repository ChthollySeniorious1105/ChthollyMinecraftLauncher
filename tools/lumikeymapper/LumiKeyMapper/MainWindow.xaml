<Window x:Class="LumiKeyMapper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:LumiKeyMapper.Controls"
        Title="LumiKeyMapper" Style="{StaticResource LumiWindow}" Width="1120" Height="740" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border x:Name="RootFrame" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <!-- ===== Title bar ===== -->
      <Grid Grid.ColumnSpan="2" x:Name="TitleBar">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Border Width="22" Height="22" CornerRadius="6">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{DynamicResource AccentBrushColor}"/>
                <GradientStop Offset="1" Color="{DynamicResource Accent2BrushColor}"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OnAccentBrush}"/>
          </Border>
          <TextBlock Text="LumiKeyMapper" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
          <TextBlock Text="按键映射" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化" AutomationProperties.Name="最大化"/>
          <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="关闭" AutomationProperties.Name="关闭"/>
        </StackPanel>
      </Grid>

      <!-- ===== Navigation rail ===== -->
      <Grid Grid.Row="1" Margin="0,6,0,0">
        <StackPanel>
          <Button x:Name="RulesNav" Style="{StaticResource NavButton}" Content="&#xE765;" AutomationProperties.Name="映射规则" Tag="selected" Click="RulesNav_Click"/>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="&#xE713;" AutomationProperties.Name="设置" Click="SettingsNav_Click"/>
          <Button x:Name="HelpNav" Style="{StaticResource NavButton}" Content="&#xE946;" AutomationProperties.Name="关于 / 帮助" Click="HelpNav_Click"/>
        </StackPanel>
      </Grid>

      <!-- ===== Content surface ===== -->
      <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,1" CornerRadius="10,0,0,0" ClipToBounds="True">
        <Grid>
          <!-- Rules page -->
          <Grid x:Name="RulesPage" Margin="32,26,32,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="映射规则" Style="{StaticResource PageTitle}"/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" FontSize="13">
                  <Run x:Name="TotalCountRun" Text="0"/><Run Text=" 条规则  ·  "/><Run x:Name="EnabledCountRun" Text="0"/><Run Text=" 条已启用  ·  "/><Run x:Name="AppsCountRun" Text="0"/><Run Text=" 个专属应用"/>
                </TextBlock>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="MasterCard" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,0,12,0" Height="40" Margin="0,0,12,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MasterLabel" Text="映射已开启" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <CheckBox x:Name="MasterSwitch" Style="{StaticResource Switch}" Click="MasterSwitch_Click" AutomationProperties.Name="映射总开关" ToolTip="映射总开关"/>
                  </StackPanel>
                </Border>
                <Button x:Name="AddButton" Style="{StaticResource AccentButton}" Click="Add_Click" Height="40" Padding="18,0" AutomationProperties.Name="新建映射">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,9,0"/><TextBlock Text="新建映射" VerticalAlignment="Center"/></StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="0,22,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="420"/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*" MinWidth="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="搜索名称、按键或应用…" TextChanged="Search_Changed" ToolTip="搜索规则名称、按键或应用" AutomationProperties.Name="搜索映射"/>
              <ComboBox Grid.Column="2" x:Name="ScopeFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="范围筛选">
                <ComboBoxItem Content="全部映射"/><ComboBoxItem Content="仅全局"/><ComboBoxItem Content="仅指定应用"/><ComboBoxItem Content="仅已停用"/>
              </ComboBox>
              <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Style="{StaticResource SubtleButton}" Click="Import_Click" ToolTip="从 JSON 文件导入配置" AutomationProperties.Name="导入">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="导入" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Click="Export_Click" ToolTip="把配置导出为 JSON 文件" AutomationProperties.Name="导出" Margin="4,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="导出" VerticalAlignment="Center"/></StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Rule cards -->
            <ScrollViewer Grid.Row="2" x:Name="RuleScroller" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,16">
              <ItemsControl x:Name="RuleList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource RuleCard}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="330"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <!-- Source → Target -->
                        <StackPanel x:Name="Keys" Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Style="{StaticResource KeyCap}" MaxWidth="140" ToolTip="{Binding Source.Category}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Source, Converter={x:Static controls:KeyGlyphConverter.Instance}}" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/>
                              <TextBlock Text="{Binding Source.Label}" Style="{StaticResource KeyCapText}"/>
                            </StackPanel>
                          </Border>
                          <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" Margin="12,0">
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                          </Border>
                          <Border Style="{StaticResource KeyCap}" MaxWidth="140" ToolTip="{Binding Target.Category}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Target, Converter={x:Static controls:KeyGlyphConverter.Instance}}" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/>
                              <TextBlock Text="{Binding Target.Label}" Style="{StaticResource KeyCapText}"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <!-- Name + scope -->
                        <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Center" Margin="20,0,16,0">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DisplayName}"/>
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border x:Name="ScopeBadge" Style="{StaticResource Badge}" Background="{DynamicResource Accent2SoftBrush}" ToolTip="{Binding ScopeLabel}">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ScopeIcon" Text="&#xE774;" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,5,0"/>
                                <TextBlock x:Name="ScopeText" Text="{Binding ScopeLabel}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="240"/>
                              </StackPanel>
                            </Border>
                            <Border x:Name="DisabledBadge" Style="{StaticResource Badge}" Margin="6,0,0,0" Visibility="Collapsed">
                              <TextBlock Text="已停用" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Style="{StaticResource Switch}" Tag="{Binding Id}" Click="RuleToggle_Click" ToolTip="启用 / 停用规则" AutomationProperties.Name="启用或停用规则" Margin="0,0,12,0"/>
                          <Rectangle Width="1" Height="20" Fill="{DynamicResource LineBrush}" Margin="0,0,6,0"/>
                          <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Tag="{Binding Id}" Click="Edit_Click" ToolTip="编辑映射" AutomationProperties.Name="编辑映射"/>
                          <Button Style="{StaticResource DangerIconButton}" Content="&#xE74D;" Tag="{Binding Id}" Click="Delete_Click" ToolTip="删除映射" AutomationProperties.Name="删除映射" Margin="2,0,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Scope}" Value="Application">
                        <Setter TargetName="ScopeBadge" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        <Setter TargetName="ScopeIcon" Property="Text" Value="&#xE737;"/>
                        <Setter TargetName="ScopeIcon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Enabled}" Value="False">
                        <Setter TargetName="Keys" Property="Opacity" Value="0.45"/>
                        <Setter TargetName="Info" Property="Opacity" Value="0.6"/>
                        <Setter TargetName="DisabledBadge" Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="2" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,60">
              <Grid Width="260" Height="150" HorizontalAlignment="Center">
                <Ellipse Width="150" Height="150" Fill="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center"/>
                <Ellipse Width="22" Height="22" Fill="{DynamicResource Accent2SoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,14,0,0"/>
                <Ellipse Width="12" Height="12" Fill="{DynamicResource Accent2Brush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,22" Opacity="0.7"/>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,30,0" Opacity="0.55"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border Style="{StaticResource KeyCap}" Width="58" Height="58" Padding="0" Background="{DynamicResource SurfaceBrush}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform Angle="-6"/></Border.RenderTransform>
                    <TextBlock Text="A" Style="{StaticResource KeyCapText}" FontSize="22"/>
                  </Border>
                  <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBrush}" Margin="12,0">
                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"/>
                  </Border>
                  <Border Style="{StaticResource KeyCap}" Width="58" Height="58" Padding="0" Background="{DynamicResource SurfaceBrush}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform Angle="6"/></Border.RenderTransform>
                    <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource TextBrush}"/>
                  </Border>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="EmptyTitle" Text="从第一个映射开始" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,8"/>
              <TextBlock x:Name="EmptyDescription" Text="比如，把鼠标侧键变成更顺手的 Enter。" Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <Button x:Name="EmptyAddButton" Style="{StaticResource AccentButton}" Click="Add_Click" HorizontalAlignment="Center" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0"/><TextBlock x:Name="EmptyAddText" Text="创建第一条映射" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Settings page -->
          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,26,32,28" MaxWidth="860" HorizontalAlignment="Left">
              <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="让 Lumi 按照你的方式工作。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,22"/>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="按住以临时暂停" Style="{StaticResource SectionTitle}"/></StackPanel>
                    <TextBlock Text="按住这个键时使用原始按键，松开后恢复映射。支持键盘键和鼠标按键；暂停键本身仍会正常发送。" Style="{StaticResource BodyText}" Margin="0,8,0,14"/>
                    <Button Style="{StaticResource LinkButton}" Click="ResetPause_Click" HorizontalAlignment="Left" Margin="-10,0,0,0">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="恢复为左 Ctrl" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                  </StackPanel>
                  <controls:InputPicker Grid.Column="1" x:Name="PausePicker" Width="280" AllowWheel="False" AreaHeight="112"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                  <CheckBox x:Name="TraySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="TraySwitch_Click" AutomationProperties.Name="关闭窗口时最小化到托盘"/>
                  <StackPanel Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="关闭窗口时，继续在托盘运行" Style="{StaticResource SectionTitle}"/></StackPanel>
                    <TextBlock Text="在系统托盘右键图标，可打开界面、暂停映射或完全退出。" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="配置与数据" Style="{StaticResource SectionTitle}"/></StackPanel>
                  <TextBlock Text="修改会自动保存在本机。导出配置可备份规则，或迁移到另一台电脑；导入前会自动备份当前配置。" Style="{StaticResource BodyText}" Margin="0,8,0,14"/>
                  <WrapPanel>
                    <Button Click="OpenFolder_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="打开配置文件夹" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="Import_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="导入配置" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="Export_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="导出配置" VerticalAlignment="Center"/></StackPanel></Button>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="外观" Style="{StaticResource SectionTitle}"/></StackPanel>
                    <TextBlock Text="界面配色自动跟随 CML 启动器主题，启动器切换主题时实时更新。" Style="{StaticResource BodyText}" Margin="0,8,0,6"/>
                    <TextBlock x:Name="ThemeSource" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Ellipse Width="18" Height="18" Fill="{DynamicResource BgBrush}" Stroke="{DynamicResource LineBrush}" Margin="0,0,4,0"/>
                      <Ellipse Width="18" Height="18" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource LineBrush}" Margin="0,0,4,0"/>
                      <Ellipse Width="18" Height="18" Fill="{DynamicResource TextBrush}" Margin="0,0,4,0"/>
                      <Ellipse Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0"/>
                      <Ellipse Width="18" Height="18" Fill="{DynamicResource Accent2Brush}"/>
                    </StackPanel>
                    <TextBlock x:Name="ThemeName" Text="默认" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- About / help page -->
          <ScrollViewer x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,26,32,28" MaxWidth="860" HorizontalAlignment="Left">
              <TextBlock Text="关于 / 帮助" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="三个步骤，建立你的第一条映射。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,22"/>

              <Border Style="{StaticResource Card}" Padding="22,20">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="56" Height="56" CornerRadius="14" VerticalAlignment="Top">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{DynamicResource AccentBrushColor}"/>
                        <GradientStop Offset="1" Color="{DynamicResource Accent2BrushColor}"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource OnAccentBrush}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="LumiKeyMapper" FontSize="18" FontWeight="SemiBold"/>
                      <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoftBrush}" Margin="10,2,0,0" VerticalAlignment="Center"><TextBlock x:Name="VersionText" Text="v1.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border>
                    </StackPanel>
                    <TextBlock Text="为每个习惯，找到顺手的按键。键盘、鼠标、滚轮单键互相映射，配置只保存在本机，不联网、不记录输入。" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <UniformGrid Columns="3" Margin="0,12,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                  <StackPanel>
                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="1" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="录入两个按键" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>
                    <TextBlock Text="新建映射，点击「原按键」区域，再按下并松开键盘键、点击鼠标按键或滚动滚轮。用同样方法录入目标键，也可以从列表选择。一次录入一个键，Esc 也可以被录入。" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                  <StackPanel>
                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="2" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="决定在哪里生效" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>
                    <TextBlock Text="全局规则适用于前台应用。指定应用规则可从已打开窗口中选择；需要细分窗口时，填写标题包含的文字。匹配忽略大小写，应用规则优先于全局规则，较长的标题条件优先。" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                  <StackPanel>
                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="3" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="保存，开始使用" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>
                    <TextBlock Text="保存后立即生效。键盘和鼠标映射保留按住 / 松开；滚轮映射为按键时每格短按一次。按住暂停键临时恢复原按键；总开关可持续停用。删除后可以撤销。" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="使用边界" Style="{StaticResource SectionTitle}"/></StackPanel>
                  <TextBlock Style="{StaticResource BodyText}" LineHeight="25" Margin="0,10,0,0" Text="•  Lumi 自己的窗口中不执行映射，便于随时修改规则。&#10;•  切换前台窗口、编辑规则、暂停或退出时，会释放模拟按键。&#10;•  当前支持单键与单键互换，不包含组合键宏或向后台窗口发送输入。&#10;•  目标应用若以管理员身份运行，Lumi 也需要以管理员身份运行。&#10;•  Windows 安全界面、Ctrl + Alt + Delete，以及屏蔽模拟输入的游戏不在支持范围内。&#10;•  软件需保持运行；关闭到托盘后，规则继续生效。"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Toast -->
          <Border x:Name="NoticeBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,18" MaxWidth="640" Background="{DynamicResource ToastBrush}" CornerRadius="8" Padding="16,6,6,6" Visibility="Collapsed">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" Direction="270"/></Border.Effect>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Foreground="{DynamicResource OnToastBrush}" Opacity="0.75" Click="DismissNotice_Click" ToolTip="关闭" AutomationProperties.Name="关闭提示" Width="30" Height="30"/>
              <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="撤销删除" Click="Undo_Click" Style="{StaticResource LinkButton}" Foreground="{DynamicResource Accent2Brush}" MinHeight="30" Visibility="Collapsed" Margin="8,0,2,0"/>
              <TextBlock x:Name="NoticeText" VerticalAlignment="Center" Foreground="{DynamicResource OnToastBrush}" TextWrapping="Wrap" Margin="0,5,8,5"/>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ===== Status bar ===== -->
      <Border x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="2" Height="34" Background="{DynamicResource BgBrush}">
        <DockPanel Margin="16,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
            <TextBlock x:Name="SaveStatus" Text="配置已保存到本机" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="StatusPill" CornerRadius="10" Padding="8,2,10,2" Background="{DynamicResource Accent2SoftBrush}">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusTitle" Text="映射正在运行" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <TextBlock Text="按住" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <Border Style="{StaticResource KeyCap}" Padding="6,0,6,1" MinWidth="0" BorderThickness="1,1,1,2" CornerRadius="4"><TextBlock x:Name="PauseLabel" Text="左 Ctrl" FontSize="10" FontWeight="SemiBold"/></Border>
            <TextBlock x:Name="PauseHint" Text="临时暂停，松开后自动恢复" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <TextBlock Text="·  应用规则优先于全局  ·  Lumi 窗口内自动停用映射" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.8"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Modal scrim while the rule editor is open -->
      <Border x:Name="Scrim" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}" Visibility="Collapsed"/>
    </Grid>
  </Border>
</Window>
